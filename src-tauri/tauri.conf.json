{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestor de Comunidades",
  "version": "0.1.0",
  "identifier": "es.gestorcomunidades.escritorio",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node tools/build-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gestor de Comunidades",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "publisher": "Luca Nizzardo",
    "copyright": "© 2026 Luca Nizzardo",
    "shortDescription": "Gestión de comunidades de propietarios",
    "longDescription": "Software para administradores de fincas: recibos por coeficiente, remesas SEPA, banco, cuentas anuales, juntas, actas, honorarios y comunicación con los vecinos.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
