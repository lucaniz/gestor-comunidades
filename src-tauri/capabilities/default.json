{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: guardar archivos que elige el usuario y abrir documentos y enlaces con el sistema.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$TEMP/gestor-comunidades"
        },
        {
          "path": "$TEMP/gestor-comunidades/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    },
    "fs:allow-mkdir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$TEMP/gestor-comunidades"
        },
        {
          "path": "$TEMP/gestor-comunidades/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
